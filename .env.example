# Stockout Firewall — environment template. Placeholders only. Never commit a real .env.
# Copy to backend/.env and frontend/.env (VITE_* only; these are public by design).

# --- Core ---
APP_ENV=local                 # local | staging | production
DEMO_MODE=true                # true = seeded data + clearly-labelled simulated providers
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database (local default works without Supabase) ---
DATABASE_URL=sqlite:///./stockout.db
# Optional local PostgreSQL (psycopg v3 is included in requirements):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stockout
# Production: Supabase connection string (use the pooled URL for Cloud Run)

# --- Supabase (production auth + RLS) ---
SUPABASE_URL=                 # e.g. https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=            # optional; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=     # public
SUPABASE_SECRET_KEY=          # BACKEND ONLY. Never expose to the browser. Not needed for request auth.
SUPABASE_JWT_SECRET=          # BACKEND ONLY. Legacy HS256 projects only; JWKS is used otherwise.

# --- Local auth fallback (demo/local only) ---
LOCAL_JWT_SECRET=change-me-locally-only

# --- Sarvam AI (speech + parsing) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai     # VERIFY against docs
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=                         # VERIFY: model list changes (sarvam-m deprecated per docs index)

# --- Gemini (optional) ---
GEMINI_API_KEY=

# --- Razorpay (payments). Start with rzp_test_ keys. ---
RAZORPAY_KEY_ID=              # public key id (sent to Checkout)
RAZORPAY_KEY_SECRET=          # BACKEND ONLY
RAZORPAY_WEBHOOK_SECRET=      # BACKEND ONLY; set the same value in the Razorpay webhook config
PAYMENTS_LIVE_ENABLED=false   # rzp_live_ keys are refused unless this is true

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=           # outbound messages (API key auth)
TWILIO_API_KEY_SECRET=        # BACKEND ONLY
TWILIO_AUTH_TOKEN=            # BACKEND ONLY; verifies inbound webhook signatures
TWILIO_WHATSAPP_FROM=         # e.g. whatsapp:+14155238886 (sandbox) or your approved sender
PUBLIC_BASE_URL=              # public HTTPS base URL Twilio calls, e.g. https://xyz.ngrok.app

# --- Road routing (OSRM HTTP API; the public demo server is for light non-commercial use) ---
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_ENABLED=true

# --- Paytm Payment Gateway (legacy adapter, disabled) ---
PAYTM_ENV=staging             # staging | production
PAYTM_MID=
PAYTM_MERCHANT_KEY=           # BACKEND ONLY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CALLBACK_URL=http://localhost:8000/api/payments/paytm/callback

# --- Google Maps Routes (optional) ---
GOOGLE_MAPS_API_KEY=          # BACKEND ONLY. Without it, distances are labelled estimates.

# --- Observability (optional) ---
SENTRY_DSN=

# --- Frontend (public) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=   # publishable key only; never a secret/service key

# Rebuild safety notes:
# Use this example as backend/.env. Local demo accounts are public fixtures.
# Production refuses demo mode and requires configured Supabase token verification.
# Non-demo payments/callbacks are disabled pending provider verification, even with keys.
# Offer freshness cutoff is currently 24h (application policy, not a provider guarantee).
